DEBUG=1
SECRET_KEY=local-development-only-change-before-deploying
ALLOWED_HOSTS=localhost,127.0.0.1
# Set this server-side only. Never put it in a VITE_ variable.
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
